# Aykut Tosun – sunucu ayarları (Hostinger / LiteSpeed / Apache)

# --- Doğru dosya türleri (uygulama yüklenebilmesi için manifest önemli) ---
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType application/xml .xml
AddDefaultCharset utf-8
AddCharset utf-8 .html .js .css .webmanifest .json .xml .txt .svg

# --- Bulunamayan sayfalar ---
ErrorDocument 404 /404.html

# --- Önbellek: sayfa, kod ve veri her seferinde sunucuya sorulsun; görseller 1 hafta ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|webmanifest|json|xml|txt|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Site araçları klasörü arama motorlarında görünmesin
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/tools/" NOINDEX
    Header set X-Robots-Tag "noindex" env=NOINDEX
  </IfModule>
</IfModule>

# --- Sıkıştırma (daha hızlı açılış) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json application/xml image/svg+xml text/plain
</IfModule>
